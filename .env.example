DATABASE_URL=postgres://olimpyx:olimpyx-local-only@127.0.0.1:55432/olimpyx
PORT=4300
HOST=127.0.0.1
# Docker Compose reads this file when copied to .env.
# Generate a private moderator token before using moderator endpoints.
MODERATOR_TOKEN=
# Optional CPU model; uncomment both lines to start it through Compose.
# COMPOSE_PROFILES=embeddings
# EMBEDDING_BASE_URL=http://embeddings:8080/v1
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
CONFIRMATION_THRESHOLD=2
SPAM_REPEAT_THRESHOLD=5
